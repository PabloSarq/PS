# Copiar este archivo como .env y completar. El archivo .env NO se sube a git.
# (Solo para desarrollo sin Docker: copiar como .env.local y agregar
#  DATABASE_URL=postgres://usuario:clave@localhost:5432/timereport)

# Contraseña de la base de datos (inventar una larga; no se usa para entrar a la app).
DB_PASSWORD=

# Primer usuario manager. Se crea solo la primera vez que arranca el sistema.
# Después de entrar, cambiá la contraseña desde "Mi cuenta".
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Pablo Sáez

NOMBRE_ESTUDIO=Sáez Sánchez Arquitectos

# Puerto en la PC servidor (http://IP-DE-LA-PC:3000 desde la red de la oficina).
PUERTO=3000

# true cuando todos entren por https (túnel de Cloudflare). Con false funciona por http en la red local.
COOKIE_SECURE=false

# Cómo se pagan las horas del sábado: extra100 o extra50 (validar con el contador).
REGLA_SABADO=extra100

# Backup diario: hora (00-23) y cuántos días se guardan.
HORA_BACKUP=02
DIAS_RETENCION=30

# Token del túnel de Cloudflare (solo si se usa acceso desde afuera).
TUNNEL_TOKEN=
